```gitignore
# ==============================
# Secrets and environment variables
# ==============================
.streamlit/secrets.toml
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# ==============================
# Databases
# ==============================
*.db
*.sqlite
*.sqlite3

# ==============================
# Editors and operating systems
# ==============================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.bak
```
.streamlit/secrets.toml

__pycache__/
*.pyc